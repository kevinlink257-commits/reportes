# OIDC/SSO — obligatorio cuando DEV_AUTH=false
OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
OIDC_ISSUER=https://idp.example.com/
OIDC_AUDIENCE=colserlog-api

# PostgreSQL
DATABASE_URL=postgresql://colserlog:CAMBIAR_PASSWORD@db:5432/colserlog
CORS_ORIGINS=https://tu-frontend.example.com
DEV_AUTH=false

# Mapas y routing. Para producción usa un proveedor propio o comercial.
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_COUNTRYCODES=co
GEOCODER_MIN_INTERVAL_SECONDS=1.0
ROUTING_URL=https://router.project-osrm.org
MAP_USER_AGENT=Colserlog/1.0 (+https://tu-dominio.example.com)
